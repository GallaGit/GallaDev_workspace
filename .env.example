# Copy to .env.local and fill secrets (never commit .env.local)
# UI overrides live in gitignored data/settings.local.json (Settings → Integraciones).
# File overrides win over these bootstrap defaults. The browser never receives full secrets.

AUTH_DISABLED=true
# Paso 2: el login es email+password con Supabase Auth (cuentas creadas por
# el Admin en Dashboard → Authentication → Users; el trigger
# on_auth_user_created les asigna rol Seller). Sin AUTH_DISABLED en prod.
# El E2E usa E2E_TEST_EMAIL + E2E_TEST_PASSWORD (usuario de prueba).
# Admin/Seller para tests/e2e/auth-sync-roles.spec.ts. No hay credencial Viewer.
# Déjalas vacías en local si no vas a correr ese spec; CI las inyecta como secrets.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=

# Demo sin cuenta (visitante). Apagada si no está definida o no es true/1.
# Para encenderla en Vercel: DEMO_MODE_ENABLED=true y un DEMO_SESSION_SECRET
# de al menos 16 caracteres (openssl rand -hex 32). Ese valor es solo de
# producción: no reutilices un secreto de CI. El workflow puede leer el
# secret de GitHub E2E_DEMO_SESSION_SECRET; si no existe, Playwright genera
# uno para ese job. Para apagar la demo sin desplegar código nuevo:
# DEMO_MODE_ENABLED=false o borrar la variable.
# La cookie firmada caduca a las 4 horas. No abre Supabase.
DEMO_MODE_ENABLED=false
DEMO_SESSION_SECRET=

SUPABASE_URL=https://rafgpbiiwofrqmfpqrij.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_0y6b9TMvbTpD96Eo2O1iEQ_DNIv9DV9
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://rafgpbiiwofrqmfpqrij.supabase.co/auth/v1/.well-known/jwks.json
# Aliases públicos para el browser (Supabase SSR). Mismo valor que SUPABASE_URL/KEY.
NEXT_PUBLIC_SUPABASE_URL=https://rafgpbiiwofrqmfpqrij.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0y6b9TMvbTpD96Eo2O1iEQ_DNIv9DV9
# Fuente de verdad de leads: siempre Supabase (el runtime Notion se eliminó).
# LEADS_DB_PROVIDER se ignora si está presente; no usar notion.
LEADS_DB_PROVIDER=supabase

# IA (Groq). Alias: AI_API_KEY, AI_MODEL, AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium
AI_PROVIDER=groq

# Búsqueda externa (alias: SERP_API_KEY)
SERPAPI_API_KEY=

# n8n — URL base y API key opcionales (test de conexión /healthz)
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_TIMEOUT_MS=15000

# Ingesta pública del formulario galladev.com (POST /api/ingest/lead).
# Secreto compartido con Cloudflare Pages (WORKSPACE_INGEST_SECRET). Generar con:
# openssl rand -hex 32 — nunca commitear el valor real.
# Solo servidor (Cloudflare), nunca en el bundle del navegador.
INGEST_SECRET=
# Secreto distinto para POST /api/ingest/n8n. Si no está, esa ruta acepta
# INGEST_SECRET (la producción no se corta). Si está y es igual, n8n responde 503.
# openssl rand -hex 32
N8N_INGEST_SECRET=
# Hosts https permitidos para webhooks y la URL base de n8n, separados por comas.
# Si no está, se acepta cualquier host público https (sin loopback, enlace local,
# rangos privados ni metadatos). Fijarla cierra el riesgo de un nombre que
# resuelva a una IP interna.
N8N_ALLOWED_HOSTS=
# Cupo de tasa compartido entre instancias. Si faltan, el límite queda en memoria
# (por instancia, no global).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhooks de automatización (nombres nuevos + alias legacy)
# Nuevo Lead
N8N_WEBHOOK_LEAD_CREATED=
N8N_WEBHOOK_BUSCAR_LEADS=
# Lead actualizado
N8N_WEBHOOK_LEAD_UPDATED=
N8N_WEBHOOK_EJECUTAR=
N8N_WEBHOOK_GENERAR_EMAIL=
# Lead analizado
N8N_WEBHOOK_LEAD_ANALYZED=
N8N_WEBHOOK_ANALIZAR_LEAD=

# Emails transaccionales tras ingest web (Resend, canal clientes — NO marketing)
# y módulo Correo (envío + Receiving API para cuerpos entrantes).
# RESEND_API_KEY: clave API de Resend con full access (nunca commitear el valor).
#   sending_access solo permite enviar; leer GET /emails/receiving/{id} exige full access.
# EMAIL_FROM_CLIENTS: remitente verificado (default GallaDev <hola@galladev.com>).
# EMAIL_NOTIFY_TO: bandeja interna (Ociel) para aviso de nuevo lead.
# EMAIL_REPLY_TO: opcional.
RESEND_API_KEY=
EMAIL_FROM_CLIENTS=GallaDev <hola@galladev.com>
EMAIL_NOTIFY_TO=
EMAIL_REPLY_TO=
