# Copy to .env.local and fill secrets (never commit .env.local)
# UI overrides live in gitignored data/settings.local.json (Settings → Integraciones).
# File overrides win over these bootstrap defaults. The browser never receives full secrets.

NOTION_TOKEN=
NOTION_DATABASE_ID=ed07cdd4c5424f9a8b8ebd73e358c6cd
NOTION_DATA_SOURCE_ID=27fefc60-8dfd-4356-9465-582d3c49d99f
AUTH_DISABLED=true

SUPABASE_URL=https://rafgpbiiwofrqmfpqrij.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_0y6b9TMvbTpD96Eo2O1iEQ_DNIv9DV9
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://rafgpbiiwofrqmfpqrij.supabase.co/auth/v1/.well-known/jwks.json
# Aliases públicos para el browser (Supabase SSR). Mismo valor que SUPABASE_URL/KEY.
NEXT_PUBLIC_SUPABASE_URL=https://rafgpbiiwofrqmfpqrij.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0y6b9TMvbTpD96Eo2O1iEQ_DNIv9DV9
# Fuente de verdad de leads: notion | supabase. Default notion (paralelo seguro).
LEADS_DB_PROVIDER=notion

# IA (Groq). Alias: AI_API_KEY, AI_MODEL, AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=1
GROQ_MAX_COMPLETION_TOKENS=2048
GROQ_TOP_P=1
GROQ_REASONING_EFFORT=medium
AI_PROVIDER=groq

# Búsqueda externa (alias: SERP_API_KEY)
SERPAPI_API_KEY=

# n8n — URL base y API key opcionales (test de conexión /healthz)
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_TIMEOUT_MS=15000

# Ingesta pública del formulario galladev.com (POST /api/ingest/lead).
# Secreto compartido con Cloudflare Pages (WORKSPACE_INGEST_SECRET). Generar con:
# openssl rand -hex 32 — nunca commitear el valor real.
INGEST_SECRET=

# Webhooks de automatización (nombres nuevos + alias legacy)
# Nuevo Lead
N8N_WEBHOOK_LEAD_CREATED=
N8N_WEBHOOK_BUSCAR_LEADS=
# Lead actualizado
N8N_WEBHOOK_LEAD_UPDATED=
N8N_WEBHOOK_EJECUTAR=
N8N_WEBHOOK_GENERAR_EMAIL=
# Lead analizado
N8N_WEBHOOK_LEAD_ANALYZED=
N8N_WEBHOOK_ANALIZAR_LEAD=
